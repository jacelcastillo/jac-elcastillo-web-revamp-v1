{
  "name": "web-jac-el-castillo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test lib/*.test.ts",
    "check-urls": "node scripts/check-urls.mjs",
    "wp:up": "docker compose -f wordpress/compose.yml up -d",
    "wp:setup": "docker compose -f wordpress/compose.yml run --rm -T wpcli bash /dev-scripts/setup.sh",
    "wp:check": "node scripts/check-wp.mjs http://localhost:8081",
    "wp:zip": "bash scripts/zip-plugin.sh"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0"
}
